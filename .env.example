# ---------------------------------------------------------------------------
# COD Profit Tracker - environment template
# Copy to .env and fill in real values:   cp .env.example .env
#
# Use `.env` rather than `.env.local`: the Prisma CLI (migrate, studio) reads
# only `.env`, while Next.js reads both. `.env.local`, if present, wins for the
# app. Both are gitignored - never commit live credentials.
# ---------------------------------------------------------------------------

# 1. META MARKETING API
META_ACCESS_TOKEN="<system-user-or-long-lived-access-token>"
META_AD_ACCOUNT_ID="act_<your_ad_account_id>"
META_APP_ID="<your_app_id>"
META_APP_SECRET="<your_app_secret>"
META_API_VERSION="v21.0"

# 2. SHOPIFY WEBHOOK
# Shopify shows this signing secret when you create the webhook subscription.
SHOPIFY_WEBHOOK_SECRET="<shopify_webhook_signing_secret>"

# 3. MDM EXPRESS REST API
MDM_API_BASE_URL="https://api.mdm.express"
MDM_API_KEY="<mdm_api_key>"
# How the API key is sent. Run `npm run mdm:probe` to find the one this
# account accepts. One of: bearer (default), raw, token, x-api-key, api-key,
# x-auth-token, body-api_key, body-token, query-api_key.
MDM_AUTH_SCHEME="bearer"

# 4. DATABASE & SERVER
DATABASE_URL="postgresql://user:password@localhost:5432/cod_tracker?schema=public"
NEXTAUTH_SECRET="<openssl rand -base64 32>"

# 5. OPTIONAL
# Bearer token that lets a scheduler call /api/sync/* without a session cookie.
CRON_SECRET="<openssl rand -hex 32>"
# Currency suffix shown next to every amount in the UI.
DEFAULT_CURRENCY="MAD"
NEXT_PUBLIC_CURRENCY="MAD"

# Seed credentials for the first dashboard user (npm run db:seed).
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-now"
